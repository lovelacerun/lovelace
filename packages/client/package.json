{
  "name": "@lovelace/client",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@lovelace/core": "workspace:*",
    "@lovelace/server": "workspace:*",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  }
}
