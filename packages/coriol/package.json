{
  "name": "@lovelace/coriol",
  "version": "0.1.0",
  "description": "Managed Git worktrees with dependency-warm seed clones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovelacerun/lovelace.git",
    "directory": "packages/coriol"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepack": "pnpm build",
    "dev": "tsc --watch",
    "test": "pnpm build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.18.2",
    "execa": "9.6.0",
    "p-limit": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
