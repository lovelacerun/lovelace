{
  "name": "@lovelace/core",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@lovelace/github-client": "workspace:*",
    "@lovelace/jira-client": "workspace:*",
    "@lovelace/model-catalog": "workspace:*",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  }
}
